if(NOT EXISTS "${PLAYER}")
    message(FATAL_ERROR "Player executable is required")
endif()
execute_process(COMMAND "${PLAYER}" --help RESULT_VARIABLE status OUTPUT_VARIABLE help ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT help MATCHES "--verify-install" OR help MATCHES "--trace-")
    message(FATAL_ERROR "Player help boundary changed: ${status} ${error}")
endif()
execute_process(COMMAND "${PLAYER}" --unknown-player-option RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "Unknown player option must return 2")
endif()
if(output MATCHES "--trace-" OR output MATCHES "--render-" OR error MATCHES "--trace-" OR error MATCHES "--render-")
    message(FATAL_ERROR "Diagnostic command catalog leaked through the player entry")
endif()
if(DEFINED TOOLS)
    execute_process(COMMAND "${TOOLS}" --help RESULT_VARIABLE status OUTPUT_VARIABLE help ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT help MATCHES "stellar7-tools --trace-" OR NOT help MATCHES "--decode-first-screen")
        message(FATAL_ERROR "Diagnostic help boundary changed: ${status} ${error}")
    endif()
endif()

