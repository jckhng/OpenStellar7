# Portable, assets-free runtime layout. Mutable data and saves are never installed.
set(STELLAR7_PACKAGE_VERSION "candidate" CACHE STRING "Runtime package label")
if(NOT STELLAR7_PACKAGE_VERSION MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
    message(FATAL_ERROR "Use a plain runtime package label")
endif()
get_filename_component(payload "${CMAKE_CURRENT_LIST_DIR}/../../tools/package/payload" ABSOLUTE)
set(package_files "stellar7${CMAKE_EXECUTABLE_SUFFIX}" "README.txt"
    "notices/LICENSE.txt" "notices/YMFM-LICENSE.txt" "notices/ORIGINAL-DATA.txt"
    "notices/SDL2-LICENSE.txt")
set(profile_name Stellar7)
if(STELLAR7_ENHANCED)
    set(profile_name Stellar7Enhanced)
endif()
install(TARGETS stellar7 RUNTIME DESTINATION .)
foreach(notice LICENSE YMFM-LICENSE ORIGINAL-DATA)
    install(FILES "${payload}/notices/${notice}.txt" DESTINATION notices)
endforeach()
install(FILES "${payload}/notices/SDL2-LICENSE.txt" DESTINATION notices)

if(WIN32)
    install(FILES "$<TARGET_FILE:${stellar7_sdl_library}>" DESTINATION .)
    if(STELLAR7_ENHANCED)
        install(FILES "${CMAKE_CURRENT_LIST_DIR}/../windows/Play-safe.cmd" DESTINATION . RENAME Play.cmd)
    else()
        install(FILES "${payload}/Play.cmd" DESTINATION .)
    endif()
    # Keep the existing audited Windows ten-file layout.
    install(FILES "${payload}/notices/MSVC-REDIST.txt" DESTINATION notices)
    list(APPEND package_files "Play.cmd" "SDL2.dll" "notices/MSVC-REDIST.txt")
    set(package_entry "Play.cmd")
    set(package_platform "Windows x64")
    set(package_profile "%LOCALAPPDATA%\\\\${profile_name}")
    set(package_runtime "static Microsoft VC${MSVC_TOOLSET_VERSION} + SDL2")
    file(READ "${payload}/README.txt" package_readme)
    if(STELLAR7_ENHANCED)
        string(REPLACE "Stellar7" "Stellar7Enhanced" package_readme "${package_readme}")
        string(APPEND package_readme "\nEnhanced: F9 toggles cockpit/chase; F12 opens native display, camera, audio and control options. Custom F9 bindings keep priority.\n")
    endif()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/package-README.txt" "${package_readme}")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/package-README.txt" DESTINATION . RENAME README.txt)
else()
    list(APPEND package_files "Play.sh")
    install(PROGRAMS "${CMAKE_CURRENT_LIST_DIR}/../packaging/Play.sh" DESTINATION .)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../packaging/README-linux.txt" package_readme)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/package-README.txt" "${package_readme}")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/package-README.txt" DESTINATION . RENAME README.txt)
    set(package_entry "Play.sh")
    set(package_platform "${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}")
    set(package_profile "XDG_DATA_HOME/dos-re-harness/${profile_name}")
    set(package_runtime "system SDL2 and C++ runtime")
endif()
set(package_sdl_version "${SDL2_VERSION}")
if(NOT package_sdl_version)
    set(package_sdl_version "${STELLAR7_SDL2_VERSION}")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/InstallManifest.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/InstallManifest.cmake" @ONLY)
install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/InstallManifest.cmake")

set(CPACK_PACKAGE_NAME Stellar7)
set(CPACK_PACKAGE_VERSION "${STELLAR7_PACKAGE_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "Stellar7-${STELLAR7_PACKAGE_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_PACKAGING_INSTALL_PREFIX "/Stellar7")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/ExactZip.cmake.in"
        "${CMAKE_CURRENT_BINARY_DIR}/ExactZip.cmake" @ONLY)
    set(CPACK_POST_BUILD_SCRIPTS "${CMAKE_CURRENT_BINARY_DIR}/ExactZip.cmake")
else()
    set(CPACK_GENERATOR TGZ)
endif()
if(NOT WIN32 OR NOT CMAKE_VERSION VERSION_LESS 3.19)
    include(CPack)
else()
    message(STATUS "Exact Windows ZIP packaging needs CMake 3.19+; directory installation remains available")
endif()
