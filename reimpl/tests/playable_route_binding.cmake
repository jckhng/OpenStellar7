# Runtime fixture admission: hashes bind inputs, reconstructed text provenance,
# supplied resources and existing golden evidence. This does not execute a fixture script.
foreach(required REPLAY_DIR RESOURCE_DIR REPLAY_EXE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(STRINGS "${REPLAY_DIR}/bindings.csv" rows)
list(REMOVE_AT rows 0)
foreach(row IN LISTS rows)
    if(NOT row MATCHES "^([^,]+),([0-9A-Fa-f]+),(.+)$")
        message(FATAL_ERROR "Invalid fullroute binding row")
    endif()
    set(kind "${CMAKE_MATCH_1}")
    set(expected "${CMAKE_MATCH_2}")
    set(path "${CMAKE_MATCH_3}")
    if(kind STREQUAL "fixture")
        set(path "${REPLAY_DIR}/${path}")
    elseif(kind STREQUAL "resource")
        set(path "${RESOURCE_DIR}/${path}")
    elseif(NOT kind STREQUAL "reference")
        message(FATAL_ERROR "Unsupported fullroute binding kind: ${kind}")
    endif()
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing qualified fullroute input: ${path}")
    endif()
    file(SHA256 "${path}" actual)
    string(TOUPPER "${actual}" actual)
    string(TOUPPER "${expected}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Changed qualified fullroute input: ${path}")
    endif()
endforeach()
execute_process(COMMAND "${REPLAY_EXE}" "${RESOURCE_DIR}" "${REPLAY_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Qualified fullroute replay failed: ${result}")
endif()
