# CPack emits directory entries; retain the existing exact-file ZIP contract.
set(root "${CPACK_TEMPORARY_DIRECTORY}")
list(LENGTH CPACK_PACKAGE_FILES archive_count)
if(NOT archive_count EQUAL 1 OR IS_SYMLINK "${root}/Stellar7")
    message(FATAL_ERROR "Expected one assets-free Windows ZIP")
endif()
get_filename_component(archive_name "${CPACK_PACKAGE_FILES}" NAME)
file(GLOB top RELATIVE "${root}" "${root}/*")
set(expected_top "Stellar7;${archive_name}")
list(SORT top)
list(SORT expected_top)
if(NOT top STREQUAL expected_top)
    message(FATAL_ERROR "Unexpected files outside runtime ZIP root")
endif()
set(expected "@package_files@;manifest.json")
list(TRANSFORM expected PREPEND "Stellar7/")
file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${root}" "${root}/Stellar7/*")
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected files in assets-free ZIP staging")
endif()
foreach(name IN LISTS expected)
    if(IS_SYMLINK "${root}/${name}")
        message(FATAL_ERROR "Symlink in runtime ZIP staging")
    endif()
endforeach()
foreach(archive IN LISTS CPACK_PACKAGE_FILES)
    execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${archive}.exact.zip" --format=zip -- ${expected}
        WORKING_DIRECTORY "${root}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot create exact runtime ZIP")
    endif()
    file(RENAME "${archive}.exact.zip" "${archive}")
endforeach()
