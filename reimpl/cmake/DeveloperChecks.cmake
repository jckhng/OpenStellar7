# Developer-only checks; ordinary player packages retain their existing flags.
option(STELLAR7_DEVELOPER_WARNINGS "Enable warnings on project runtime code" OFF)
option(STELLAR7_SANITIZERS "Enable address/undefined sanitizers with GCC or Clang" OFF)

if(STELLAR7_DEVELOPER_WARNINGS)
    foreach(target stellar7_core stellar7_player stellar7_assets stellar7_host
        stellar7_gl stellar7_openxr stellar7_openxr_host stellar7 stellar7-tools)
        if(TARGET ${target})
            if(MSVC)
                target_compile_options(${target} PRIVATE /W4)
            else()
                target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
            endif()
        endif()
    endforeach()
    # Vendor sources remain unchanged and outside the project's warning policy.
    foreach(source third_party/ymfm/ymfm_adpcm.cpp third_party/ymfm/ymfm_opl.cpp third_party/ymfm/ymfm_pcm.cpp)
        if(MSVC)
            set_property(SOURCE ${source} APPEND PROPERTY COMPILE_OPTIONS /w)
        else()
            set_property(SOURCE ${source} APPEND PROPERTY COMPILE_OPTIONS -w)
        endif()
    endforeach()
endif()

if(STELLAR7_SANITIZERS)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" OR MSVC)
        message(FATAL_ERROR "STELLAR7_SANITIZERS requires a GCC/Clang sanitizer toolchain")
    endif()
    add_library(stellar7_sanitizers INTERFACE)
    target_compile_options(stellar7_sanitizers INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(stellar7_sanitizers INTERFACE -fsanitize=address,undefined)
    get_property(project_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS project_targets)
        get_target_property(kind ${target} TYPE)
        if(kind MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY)$")
            target_link_libraries(${target} PRIVATE stellar7_sanitizers)
        endif()
    endforeach()
endif()
